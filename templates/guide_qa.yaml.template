# Guide QA Configuration — {{GUIDE_NAME}}
# Generated by /new-course-guide skill

guide:
  name: "{{GUIDE_NAME}}"
  version: "1.0"
  guide_dir: "{{GUIDE_DIR}}"
  chapters_glob: "{{GUIDE_DIR}}/chapters/*.tex"
  appendices_glob: "{{GUIDE_DIR}}/appendices/*.tex"
  cards_dir: "{{GUIDE_DIR}}/cards"
  review_dir: "docs/review"
  build_cmd: "make -C {{GUIDE_DIR}} pilot"
  full_build_cmd: "make -C {{GUIDE_DIR}} digital"

los:
  prefix: "{{LOS_PREFIX}}"
  valid_levels: [define, explain, calculate, compare, analyze, evaluate, design, apply, debug, trace]

metrics:
  los_count:
    description: "Learning Outcomes defined"
    target: {{LOS_TARGET}}
    yellow: {{LOS_YELLOW}}
    check_cmd: "grep -rc '\\\\los{' {{GUIDE_DIR}}/chapters/ | awk -F: '{s+=$2}END{print s}'"
  glossary_count:
    description: "Glossary terms"
    target: {{GLOSSARY_TARGET}}
    yellow: {{GLOSSARY_YELLOW}}
    check_cmd: "grep -c '\\\\term\\[' {{GUIDE_DIR}}/appendices/*glossary*.tex"
  bib_count:
    description: "Bibliography entries"
    target: {{BIB_TARGET}}
    yellow: {{BIB_YELLOW}}
    check_cmd: "grep -c '^@' {{GUIDE_DIR}}/references.bib"
  page_count:
    description: "Compiled PDF page count"
    target: {{PAGE_TARGET}}
    yellow: {{PAGE_YELLOW}}
    check_cmd: "pdfinfo {{GUIDE_DIR}}/{{MAIN}}.pdf 2>/dev/null | grep Pages | awk '{print $2}'"
  latex_overflow_visible:
    description: "Overfull hbox warnings >= 50pt"
    target: 0
    yellow: 5
    inverted: true
    check_cmd: "python3 scripts/validation/check_latex_warnings.py {{GUIDE_DIR}}/{{MAIN}}.log --json 2>/dev/null | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('overfull_count',0))\""

readiness_checks:
  - name: "LaTeX Build"
    blocking: true
    cmd: "make -C {{GUIDE_DIR}} pilot"
    success: "{{GUIDE_DIR}}/{{MAIN}}.pdf"
  - name: "Cross References"
    blocking: true
    cmd: "python3 scripts/validation/check_refs.py {{GUIDE_DIR}}/chapters/*.tex {{GUIDE_DIR}}/appendices/*.tex"
  - name: "LOS Validation"
    blocking: false
    cmd: "python3 scripts/validation/extract_los.py {{GUIDE_DIR}}/chapters/*.tex --validate"
  - name: "LaTeX Presentation"
    blocking: true
    cmd: "python3 scripts/validation/check_latex_warnings.py {{GUIDE_DIR}}/{{MAIN}}.log"
    threshold: 5

