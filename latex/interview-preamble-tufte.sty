% PROFESSIONAL COVER PAGE
% =============================================================================
% Extracted from Vol 4 as canonical implementation

\newcommand{\makeguidecover}{%
  \begin{titlepage}
    \centering
    \vspace*{2cm}

    {\Huge\bfseries\color{WarmBlue}\guidetitle\par}

    \vspace{0.5cm}
    {\Large\guidesubtitle\par}

    \vspace{1cm}
    {\large Interview Prep Series\par}

    \vspace{2cm}
    {\large\guideauthor\par}

    \vfill

    {\normalsize Version \guideversion\par}
    {\normalsize\guidedate\par}

    \vspace{1cm}

    \ifprintmode
      {\small\textit{Print Edition}\par}
    \else
      {\small\textit{\guideedition\ Edition}\par}
    \fi
  \end{titlepage}
}

