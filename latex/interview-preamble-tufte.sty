% =============================================================================
% HEADERS (scrlayer-scrpage) - Abbreviated format
% =============================================================================
\RequirePackage[headsepline]{scrlayer-scrpage}
\pagestyle{scrheadings}
\automark[chapter]{chapter}

% scrbook's default \chaptermark prepends the chapter number to \leftmark
% (e.g. "3. TF2: ..."). Combined with \thechapter in \ohead below, this
% produces double-numbered headers like "3 · 3. TF2: ...". Strip the
% auto-prefix so headers render the documented "[N] · [Title]" format.
\renewcommand*{\chaptermark}[1]{\markboth{#1}{}}

% Volume short name for header (defined in each guide.tex)
\providecommand{\volumeshort}{}

% Format: "ML Foundations | 12 · Bias-Variance"
\ihead{\ifx\volumeshort\empty\else\footnotesize\volumeshort\fi}
\chead{}
\ohead{\footnotesize\textit{\thechapter~·~\leftmark}}
\ifoot{} \cfoot{\pagemark} \ofoot{}

% KOMA-Script's tocbasic page-number boxes are sized by a reference digit.
% Roboto's proportional digits overflow by 1.3--5.1pt on 3-digit pages.
% Widen the page-number column for all TOC entry levels.
\DeclareTOCStyleEntry[pagenumberwidth=4em]{tocline}{chapter}
\DeclareTOCStyleEntry[pagenumberwidth=2.5em]{tocline}{section}
\DeclareTOCStyleEntry[pagenumberwidth=2.5em]{tocline}{subsection}
% Chapter TOC entries use bold 12pt Roboto, which needs more headroom
% than 4em at 10pt base. Override via LaTeX's \@pnumwidth as fallback.
\makeatletter
\renewcommand{\@pnumwidth}{2.5em}
\makeatother

