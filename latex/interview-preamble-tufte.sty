% interview-preamble-tufte.sty
% Tufte-style dense layout for interview prep guides
% Maximum information density with margin notes
%
% Usage: \usepackage{interview-preamble-tufte}
% Requires: LuaLaTeX with -shell-escape flag
%
% Print/Digital toggle:
%   \printmodetrue  (before \usepackage) for print variant
%   \printmodefalse (default) for digital variant

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{interview-preamble-tufte}[2025/12/02 Tufte-style Interview Guide Preamble v1.0]

% Default to generated glossaries for the wider repo, but allow guides with a
% hand-written glossary appendix to opt out before loading this package.
\@ifundefined{ifguidegeneratedglossaries}{%
  \newif\ifguidegeneratedglossaries
  \guidegeneratedglossariestrue
}{}

% =============================================================================
% ENGINE DETECTION
% =============================================================================
\RequirePackage{iftex}
\RequireLuaTeX  % Fail with clear error if not LuaLaTeX

% =============================================================================
% PRINT/DIGITAL TOGGLE
% =============================================================================
% Define if not already defined (allows command-line override)
\@ifundefined{ifprintmode}{%
  \newif\ifprintmode
  \printmodefalse  % Default to digital
}{}

% =============================================================================
% TUFTE-STYLE GEOMETRY
% =============================================================================
\RequirePackage{geometry}
\geometry{
    paperwidth=8.5in,
    paperheight=11in,
    left=1in,              % Inner margin
    top=1in,
    textwidth=4.5in,       % Main text (narrow for density)
    marginparsep=0.3in,    % Gap between text and margin
    marginparwidth=1.9in,  % Wide margin for notes/figures
    textheight=9in,
    footskip=0.5in,
    headheight=23pt
}

% scrbook auto-loads typearea, which recomputes \textheight using its own
% DIV factor on every later \KOMAoptions{} call and silently discards
% geometry's textheight. Re-assert at \AtBeginDocument so geometry wins;
% otherwise typearea clamps text to ~6.45in on 11in paper, leaving ~2.3in
% of wasted bottom whitespace per page.
\AtBeginDocument{\geometry{textheight=9in}}

% Tufte canonical: don't stretch inter-paragraph glue to fill the page;
% let pages end naturally where content does. The original tufte-book
% class hardcodes this; math-heavy content with frequent theorem/figure
% breaks looks visibly cleaner without flushbottom glue stretching.
\raggedbottom

% Full-width length for tables/figures inside \begin{fullwidth}
% adjustwidth does not update \linewidth, so tables need this explicitly
\newlength{\fullwidthlen}
\AtBeginDocument{\setlength{\fullwidthlen}{\dimexpr\textwidth+\marginparwidth+\marginparsep\relax}}

% Global emergency stretch: allows TeX to widen inter-word spaces by up to
% 1em as a last resort, preventing sub-10pt overfull hbox warnings from
% Roboto's wide glyphs in narrow 4.5in text columns.
\setlength{\emergencystretch}{2em}

% =============================================================================
% FONTS (must come early)
% =============================================================================
\RequirePackage{fontspec}

% Define fallback font for symbols not in Roboto (e.g., ★ U+2605)
\directlua{
  luaotfload.add_fallback("symbolfallback", {
    "DejaVu Sans:mode=harf;",
  })
}

% Main font: Roboto (modern sans-serif) - 10pt from documentclass
\setmainfont{Roboto}[
  UprightFont = *-Regular,
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic,
  Scale = 1.0,
  RawFeature={fallback=symbolfallback}
]

% Monospace font: Source Code Pro - 9pt effective (0.82 scale of 10pt)
\setmonofont{Source Code Pro}[
  Scale = 0.82,
  UprightFont = *-Regular,
  BoldFont = *-Bold,
  ItalicFont = *-It,
  BoldItalicFont = *-BoldIt
]

% Sans font (for headings): already Roboto as main
\setsansfont{Roboto}[
  UprightFont = *-Regular,
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic
]

% Margin note sizing uses explicit digital sizes so 10pt and 11pt guides share
% the same compact, readable callout footprint.
\newcommand{\marginfontsize}{%
  \ifprintmode
    \footnotesize
  \else
    \fontsize{6.7}{7.6}\selectfont
  \fi
}
\newcommand{\margintitlefontsize}{%
  \ifprintmode
    \small
  \else
    \fontsize{6.8}{7.4}\selectfont
  \fi
}
\DeclareMathSizes{6.7}{6.7}{5}{5}
\DeclareMathSizes{6.8}{6.8}{5}{5}

% =============================================================================
% TYPOGRAPHY
% =============================================================================
\RequirePackage[
  protrusion=true,
  expansion=true,
  tracking=smallcaps,
  % spacing=true,  % Not supported by LuaLaTeX
  final
]{microtype}           % Microtypography (kerning, protrusion, expansion)

% Allow punctuation to extend into margins (absorbs micro-overflows)
\SetProtrusion{encoding=*,family=*}{
  1={-100,-100},
  .={0,500},
  ,={0,500}
}

% babel + csquotes loaded after minted (see CODE LISTINGS section)
% to avoid fvextra/csquotes load-order warning

% Line spacing - Balanced for readability (code blocks use separate tight setting)
\RequirePackage{setspace}
\setstretch{1.15}  % Body text: comfortable reading (code blocks override to 1.05)
\RequirePackage{ragged2e}

% Paragraph formatting - TRUE TUFTE STYLE: indent instead of parskip
\setlength{\parindent}{1em}  % Was 0pt - proper paragraph indents
\setlength{\parskip}{0pt}    % Was 0.25\baselineskip - no extra space

% =============================================================================
% COLORS — Warm 6-hue palette (colorblind-safe, desaturated)
% =============================================================================
\RequirePackage[dvipsnames,svgnames,x11names,table]{xcolor}

% --- Canonical warm palette (6 semantic families + 3 neutrals) ---
\definecolor{WarmBlue}{HTML}{3B6FA0}         % Structure, LOS, headings
\definecolor{WarmRose}{HTML}{C06858}         % Warnings, redflags, mistakes
\definecolor{WarmGreen}{HTML}{4A7E3F}        % Interview, practice, tips
\definecolor{WarmPlum}{HTML}{8A4E82}         % Deep dive, authority
\definecolor{WarmGold}{HTML}{C09840}         % Insight, paradox, bridges
\definecolor{WarmTeal}{HTML}{4A8C8C}         % Comparison, drills, systems
\definecolor{CodeBg}{HTML}{F7F5F0}           % Backgrounds (warm off-white)
\definecolor{CodeFrame}{HTML}{B5B3AA}        % Borders
\definecolor{DarkText}{HTML}{1A1A19}         % Body text

% --- Backward-compatible aliases (old name → warm palette) ---
\colorlet{PrimaryBlue}{WarmBlue}
\colorlet{NoteBlue}{WarmBlue}
\colorlet{CFABlue}{WarmBlue}
\colorlet{WarningOrange}{WarmRose}
\colorlet{CrimsonRed}{WarmRose}
\colorlet{TipGreen}{WarmGreen}
\colorlet{ForestGreen}{WarmGreen}
\colorlet{RoyalPurple}{WarmPlum}
\colorlet{SunsetOrange}{WarmGold}
\colorlet{OceanTeal}{WarmTeal}
\colorlet{SteelBlue}{WarmTeal}
\colorlet{SaddleBrown}{WarmGold!60!black}

% =============================================================================
% CODE LISTINGS (minted - Pygments backend) - OPTIMIZED for density
% =============================================================================
\RequirePackage{minted}

% Configure minted based on print/digital mode
\ifprintmode
  % Print: white background, left border only
  \setminted{
    frame=leftline,             % Only left border (was single)
    framesep=1.5mm,             % Reduced from 2mm
    bgcolor=white,
    rulecolor=CodeFrame,
    fontsize=\footnotesize,     % 9pt code
    breaklines=true,
    breakanywhere=false,
    linenos=true,               % Keep for print reference
    numbersep=4pt,              % Reduced from 5pt
    xleftmargin=0pt,            % Reduced from 8pt
    baselinestretch=1.15,       % Increased from 1.1 (readability)
    autogobble=true
  }
\else
  % Digital: tinted background, top/bottom lines only
  \setminted{
    frame=lines,                % Top/bottom only (modern, saves space)
    framesep=1mm,               % Reduced from 1.5mm (saves 3pt/block)
    bgcolor=CodeBg,
    rulecolor=CodeFrame,
    fontsize=\footnotesize,     % 9pt code
    breaklines=true,
    breakanywhere=false,
    linenos=false,              % NO line numbers (saves 15pt per block!)
    xleftmargin=0pt,            % Reduced from 8pt
    baselinestretch=1.05,       % Further reduced from 1.10 (saves 2-3pt per block)
    autogobble=true
  }
\fi

\usemintedstyle{friendly}  % Good balance of color and readability

% Listings compatibility (some chapters use lstlisting instead of minted)
\RequirePackage{listings}
\lstset{
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{WarmBlue},
  commentstyle=\color{gray},
  stringstyle=\color{WarmGold},
  showstringspaces=false,
  breaklines=true,
  frame=single,
  numbers=none,
  tabsize=4,
  backgroundcolor=\color{CodeBg}
}

\RequirePackage[english]{babel}      % Language support (after minted/fvextra)
\RequirePackage{csquotes}            % Smart quotes (must follow fvextra)

% Inline code
\newcommand{\code}[1]{\texttt{#1}}

% Code block caption/title styling
\newcommand{\codecaption}[1]{%
  \par\vspace{-0.3\baselineskip}%
  {\footnotesize\color{WarmBlue!80!black}\textbf{#1}}%
  \par\vspace{-0.2\baselineskip}%
}

% Spacing after code blocks
\newcommand{\postcode}{\vspace{-0.3\baselineskip}}

% =============================================================================
% MARGIN NOTE COMMANDS (Tufte-style)
% =============================================================================
\RequirePackage{changepage}  % For fullwidth environment
\RequirePackage{marginnote}  % Works inside tcolorbox/floats (unlike \marginpar)

% Save package's \marginnote before we redefine it
\let\pkgmarginnote\marginnote

% Basic sidenote - uses pkgmarginnote to work inside tcolorbox
\newcommand{\sidenote}[1]{%
  \pkgmarginnote{%
    \footnotesize\raggedright%  % 9pt instead of 11pt
    \color{WarmBlue!70!black}%
    #1%
    \color{DarkText}%
  }%
}

% Margin figure
\newcommand{\marginfigure}[2][width=\marginparwidth]{%
  \pkgmarginnote{\centering\includegraphics[#1]{#2}}%
}

% Margin table environment
\newenvironment{margintable}
  {\pkgmarginnote\bgroup\marginfontsize\centering}
  {\egroup}

% Full-width environment (for large figures/tables spanning text + margin)
\newenvironment{fullwidth}
  {\begin{adjustwidth}{}{-\marginparwidth-\marginparsep}}
  {\end{adjustwidth}}

% =============================================================================
% CALLOUT BOXES (tcolorbox) - BOTH MARGIN AND MAIN TEXT
% =============================================================================
\RequirePackage[breakable,skins]{tcolorbox}

% Conditional backgrounds based on print mode
\ifprintmode
  \newcommand{\notebg}{white}
  \newcommand{\warnbg}{white}
  \newcommand{\tipbg}{white}
\else
  \colorlet{notebg}{WarmBlue!5}
  \colorlet{warnbg}{WarmRose!5}
  \colorlet{tipbg}{WarmGreen!5}
\fi

% --- MARGIN CALLOUT BOXES (compact, for margins) ---

\newtcolorbox{marginbox}[2][Note]{
  breakable=false,
  enhanced,
  colframe=#2,
  colback=\ifprintmode white\else #2!3\fi,  % More subtle (was 5%)
  coltitle=DarkText,
  fonttitle=\bfseries\margintitlefontsize,
  before title={\RaggedRight},
  title=#1,
  leftrule=1.5pt,
  rightrule=0pt,
  toprule=0pt,
  bottomrule=0pt,
  arc=0pt,
  left=0pt,
  right=0pt,
  top=0pt,
  bottom=0pt,
  boxsep=0pt,
  width=\marginparwidth,
  fontupper=\marginfontsize,
  before upper={\RaggedRight\sloppy\emergencystretch=3em\relax},
  titlerule=0mm
}

% Convenience commands for margin callouts (using pkgmarginnote for tcolorbox safety)
\renewcommand{\marginnote}[2][Note]{%
  \pkgmarginnote{\begin{marginbox}[#1]{WarmBlue}#2\end{marginbox}}%
}

\newcommand{\marginwarning}[2][Warning]{%
  \pkgmarginnote{\begin{marginbox}[#1]{WarmRose}#2\end{marginbox}}%
}

\newcommand{\margintip}[2][Tip]{%
  \pkgmarginnote{\begin{marginbox}[#1]{WarmGreen}#2\end{marginbox}}%
}

% --- MAIN TEXT CALLOUT BOXES (compact, for important content) ---

% Unified compact style for all callout boxes (PHASE 3)
\tcbset{
  callout-compact/.style={
    breakable,
    enhanced,
    arc=0pt,
    leftrule=3pt,
    rightrule=0pt,
    toprule=0pt,
    bottomrule=0pt,
    left=2pt,          % Reduced from 3pt
    right=2pt,         % Reduced from 3pt
    top=1pt,           % Reduced from 2pt
    bottom=1pt,        % Reduced from 2pt
    boxsep=0pt,
    toptitle=0.5pt,    % Space above title (was titlesep)
    coltitle=DarkText,
    fonttitle=\bfseries,
    before title={\RaggedRight},
    before upper={\RaggedRight\sloppy\emergencystretch=1em\relax}
  }
}

% Note box (blue) - COMPACT
\newtcolorbox{notebox}[1][Note]{
  callout-compact,
  colframe=WarmBlue,
  colback=\ifprintmode white\else WarmBlue!3\fi,
  title=#1
}

% Warning box (rose) - COMPACT
\newtcolorbox{warnbox}[1][Warning]{
  callout-compact,
  colframe=WarmRose,
  colback=\ifprintmode white\else WarmRose!3\fi,
  title=#1
}

% Tip box (green) - COMPACT
\newtcolorbox{tipbox}[1][Tip]{
  callout-compact,
  colframe=WarmGreen,
  colback=\ifprintmode white\else WarmGreen!3\fi,
  title=#1
}

% Example box (blue) - COMPACT
\newtcolorbox{examplebox}[1][Example]{
  callout-compact,
  colframe=WarmBlue,
  colback=\ifprintmode white\else WarmBlue!3\fi,
  title=#1
}

