% ============================================================================
% CLOZE TERM (for fill-in-the-blank Anki cards)
% ============================================================================

% Load expl3 for regex-based cloze stripping
\RequirePackage{expl3}
\ExplSyntaxOn

% Store the result in a tl variable
\tl_new:N \l_cloze_result_tl

% \StripClozeExpl{text} - strips c1::, c2::, etc. using regex
\cs_new:Npn \StripClozeExpl #1 {
  \tl_set:Nn \l_cloze_result_tl {#1}
  % Remove c1:: through c9:: patterns
  \regex_replace_all:nnN { c[1-9]:: } {} \l_cloze_result_tl
  \tl_use:N \l_cloze_result_tl
}

% User-facing command (works in normal LaTeX syntax)
\cs_new:Npn \StripAllCloze #1 { \StripClozeExpl{#1} }
\ExplSyntaxOff

% \clozeterm[LOS]{term}{definition}
% For PDF: renders as bold term followed by definition (cloze syntax stripped)
% For Anki: extraction pipeline creates cloze deletion card
%
% Cloze syntax {{c1::text}} renders as just "text" in PDF
% The extraction script reads the raw LaTeX and creates proper Anki cloze cards
\newcommand{\clozeterm}[3][]{%
  \textbf{#2}: \StripAllCloze{#3}%
  % LOS #1 captured for extraction but not rendered
}

% Optional explanatory back for the most recent \clozeterm above. Renders as
% a small indented italic "Why" note in the PDF and is captured by the Anki
% extractor as the cloze card's back field — single-source-of-truth so the
% explanation cannot drift between the printed guide and the spaced-repetition
% deck. Place \clozeback immediately after the matching \clozeterm.
\newcommand{\clozeback}[1]{%
  \\[2pt]\hspace*{1em}\textit{\footnotesize #1}%
}

% ============================================================================
% DATED CONTENT ENVIRONMENT (for rapidly-changing fields)
% ============================================================================

\NewDocumentEnvironment{datedcontent}{m}{%
  \begin{tcolorbox}[colback=white, colframe=black!30, fonttitle=\bfseries\small,
    title={Last updated: #1}, arc=1mm, boxrule=0.3mm, left=2mm, right=2mm,
    top=1mm, bottom=1mm, breakable]
}{%
  \end{tcolorbox}%
}

% ============================================================================
% WALKTHROUGH ENVIRONMENT (Step-by-step guided exercises)
% ============================================================================

\makeatletter
\@ifundefined{walkthrough}{%
  \colorlet{walkthroughgreen}{WarmGreen}
  \NewDocumentEnvironment{walkthrough}{O{Walkthrough}}{%
    \begin{tcolorbox}[colback=walkthroughgreen!5, colframe=walkthroughgreen!75!black,
      fonttitle=\bfseries, title={#1}, arc=2mm, boxrule=0.5mm,
      left=3mm, right=3mm, top=2mm, bottom=2mm, breakable]
  }{%
    \end{tcolorbox}%
  }
}{}
\makeatother

% ============================================================================
% GENERATION-BEFORE-READING PROMPT
% ============================================================================
% Research: Slamecka & Graf (1978) generation effect; DeWinstanley & Bjork (2004).
% Generating an answer (even incorrectly) produces stronger memory traces than
% reading the answer. Place before sections that answer the question.
%
% Usage: \begin{generatefirst}[Optional title]
%          What would you expect to find in a policy gradient loss function?
%        \end{generatefirst}

\colorlet{generategold}{WarmGold}
\NewDocumentEnvironment{generatefirst}{O{Predict Before Reading}}{%
  \begin{tcolorbox}[colback=generategold!8, colframe=generategold!75!black,
    fonttitle=\bfseries, title={\textsc{#1}},
    arc=2mm, boxrule=0.5mm,
    left=3mm, right=3mm, top=2mm, bottom=2mm, breakable]
}{%
  \end{tcolorbox}%
}

% Companion metadata macro — invisible in PDF, read by the card extractor
% (shared/cards/extract_cards.py) to fill the Anki back of the generatefirst
% card. Place inside a \begin{generatefirst}...\end{generatefirst} block to
% supply a model answer. Preserves the Slamecka & Graf generation-effect
% pedagogy in the PDF (no answer shown) while giving spaced-repetition
% reviewers gradeable feedback.
\providecommand{\generateanswer}[1]{}

