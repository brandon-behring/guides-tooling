% ============================================================================
% LEARNING OUTCOME STATEMENTS
% ============================================================================

% \los{ID}{level}{statement}
% Canonical 10 levels (see docs/standards/00_universal/learning_outcomes.md):
%   define, explain, calculate, compare, analyze, evaluate, design, apply, debug, trace
% Machine-readable mirror at shared/config/canonical_values.yaml (bloom_levels key).
\newcommand{\los}[3]{%
  \item[\textcolor{losblue}{\textbf{LOS #1}}] %
  (\textit{#2}): #3%
  \index{LOS!#1}%
  \label{los:#1}%
}

% Environment for chapter LOS list
\newenvironment{learningoutcomes}{%
  \subsection*{Learning Outcomes}
  After completing this reading, you should be able to:
  \begin{description}[leftmargin=1cm, labelindent=0cm, font=\normalfont]
}{%
  \end{description}
}

% ============================================================================
% TERM DEFINITIONS (extractable for Anki cards)
% ============================================================================

% \term[LOS]{name}{definition}
% Optional LOS parameter for card extraction traceability
% Examples:
%   \term{CUPED}{Definition...}           - backward compatible
%   \term[EXP-8.1]{CUPED}{Definition...}  - with LOS reference
\newcommand{\term}[3][]{%
  \textbf{#2}\index{#2}: #3%
  % LOS #1 captured for extraction but not rendered
}

% Inline term reference
\newcommand{\termref}[1]{%
  \textit{#1}\index{#1}%
}

