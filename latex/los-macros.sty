% ============================================================================
% PRACTICE PROBLEMS (LeetCode-style)
% ============================================================================

\newcounter{problemcounter}[chapter]
\renewcommand{\theproblemcounter}{\thechapter.\arabic{problemcounter}}

% \begin{problem}[Title][LOS-ID][Difficulty][Scaffolding]
% Four optional arguments:
%   #1 = title (rendered in box header)
%   #2 = LOS (for extraction, not rendered)
%   #3 = difficulty: foundation | standard | stretch (rendered as colored tag)
%   #4 = scaffolding: full | partial | none (for WFP progression tracking)
%        full = worked example (all steps shown)
%        partial = faded example (some steps blanked)
%        none = independent practice (default, backward-compatible)
% Research: Kapur (2008) productive failure; Bjork (1994) desirable difficulties;
%           Sweller (2011) CLT; Renkl (2002) fading worked examples
\NewDocumentEnvironment{problem}{O{} O{} O{} O{}}{%
  \refstepcounter{problemcounter}%
  \begin{tcolorbox}[%
    colback=problemgray,
    colframe=black!50,
    fonttitle=\bfseries,
    title={Problem \theproblemcounter\ifx&#1&\else{ [#1]}\fi%
      \ifx&#3&\else%
        \hfill{\small\textsc{#3}}%
      \fi%
      \ifx&#4&\else%
        \hfill{\small\textsf{[#4]}}%
      \fi},
    arc=1mm,
    boxrule=0.3mm,
    left=2.5mm,
    right=2.5mm,
    top=1.5mm,
    bottom=1.5mm,
    breakable,
    before upper={\lossloppyupper}
  ]
}{%
  \end{tcolorbox}%
  % #2 (LOS) and #3 (difficulty) captured for extraction
}

