% \substep{label}{content} — labeled sub-goals within solutions
% Research: Catrambone (1998) — sub-goal labels improve transfer 25-40%
% Auto-numbers within each solution environment
\newcommand{\substep}[2]{%
  \stepcounter{substepcounter}%
  \par\noindent\textbf{Step \thesubstepcounter: #1}\par
  #2\par\medskip
}

