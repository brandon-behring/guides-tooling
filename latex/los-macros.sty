% los-macros.sty - Learning Outcome Statement macros for CFA-style interview prep
% Part of interview_prep_series
%
% Provides:
%   \los{ID}{level}{statement} - Learning Outcome Statement
%   \term{name}{definition} - Term definition (extractable for cards)
%   \begin{interviewcontext} - Interview context box
%   \begin{redflag} - Common mistake warning
%   \begin{problem}[LOS-ID] - Practice problem
%   \begin{vignette}[Title] - CFA-style case study
%   \begin{solution} - Solution block

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{los-macros}[2025/12/26 LOS macros for interview prep]

% Required packages
\RequirePackage{tcolorbox}
\RequirePackage{xcolor}
\RequirePackage{makeidx}
\RequirePackage{enumitem}
\RequirePackage{xparse}  % For two-optional-argument environments (Phase 6)

% Math operators (requires amsmath, loaded in interview-preamble-tufte.sty)
\providecommand{\argmin}{\operatorname*{arg\,min}}
\providecommand{\argmax}{\operatorname*{arg\,max}}
\newcommand{\lossloppyupper}{\RaggedRight\sloppy\setlength{\emergencystretch}{2em}}

